# Leave the Sanity project ID empty to use the local data/*.json files instead.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret between the Sanity webhook and /api/revalidate.
SANITY_REVALIDATE_SECRET=

# Only needed to run scripts/import-to-sanity.mjs. Never add this to Vercel, and revoke it afterwards.
SANITY_WRITE_TOKEN=
